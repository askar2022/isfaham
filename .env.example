# Azure Speech resource (speech-to-text and text-to-speech)
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com
AZURE_SPEECH_KEY=

# Azure Translator resource
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Optional cost-estimation rates; update when Azure pricing changes.
AZURE_STT_USD_PER_HOUR=1
AZURE_TRANSLATION_USD_PER_MILLION_CHARACTERS=10
AZURE_TTS_USD_PER_MILLION_CHARACTERS=15

# Supabase teacher authentication and conversation storage
NEXT_PUBLIC_SUPABASE_URL=https://qntlittiumuhctmqejnn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Proxy phone-number masking and parent invitations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_SERVICE_SID=

# Resend (pilot signup emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Isfaham <hello@isfaham.org>
PILOT_NOTIFICATION_EMAIL=hello@isfaham.org

# Public website URL used in SMS invitations
NEXT_PUBLIC_SITE_URL=https://isfaham.org

# Add these after the store listings become publicly available.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
