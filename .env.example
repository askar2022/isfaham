# Azure Speech resource (speech-to-text and text-to-speech)
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com
AZURE_SPEECH_KEY=

# Azure Translator resource
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Optional cost-estimation rates; update when Azure pricing changes.
AZURE_STT_USD_PER_HOUR=1
AZURE_TRANSLATION_USD_PER_MILLION_CHARACTERS=10
AZURE_TTS_USD_PER_MILLION_CHARACTERS=15

# Supabase teacher authentication and conversation storage
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC salt for privacy-preserving API rate-limit identifiers.
# Generate a unique random value with at least 32 bytes.
RATE_LIMIT_SECRET=
# Set true after mobile builds containing the install identifier are adopted.
REQUIRE_TRIAL_DEVICE_ID=false

# Twilio Proxy phone-number masking and parent invitations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_SERVICE_SID=

# Resend (pilot signup emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Isfaham <hello@isfaham.org>
PILOT_NOTIFICATION_EMAIL=hello@isfaham.org

# Stripe Checkout for consumer translation credits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_1_HOUR=
STRIPE_PRICE_5_HOURS=
STRIPE_PRICE_10_HOURS=
STRIPE_PRICE_SCHOOL_MONTHLY=

# RevenueCat verifies Apple and Google Play consumable purchases. Add the public
# store SDK keys to mobile/.env and EAS; keep the webhook token only in Vercel.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Keep false/unset in production. Enable only for a dedicated test environment.
REVENUECAT_ALLOW_SANDBOX=false

# Public website URL used in SMS invitations
NEXT_PUBLIC_SITE_URL=https://isfaham.org

# Add these after the store listings become publicly available.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
# Android URL after release:
# https://play.google.com/store/apps/details?id=com.isfaham.app
