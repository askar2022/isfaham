{
  "expo": {
    "name": "Isfaham",
    "slug": "isfaham",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "isfaham",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isfaham.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Isfaham uses the microphone to translate conversations between Somali and English.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.isfaham.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "7a4f4bf4-4f8a-4fcd-9c37-7cc390a8797a"
      }
    },
    "owner": "askar101"
  }
}
